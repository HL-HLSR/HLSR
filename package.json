{
  "name": "hlsr",
  "version": "0.4.9",
  "author": "HLSR Team",
  "description": "Launcher that will help you to start speedrun Half-Life games.",
  "homepage": "https://hlsr.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/HL-HLSR/HLSR.git"
  },
  "bugs": {
    "url": "https://github.com/HL-HLSR/HLSR/issues"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/run-platform-script.js build",
    "build:dir": "node scripts/run-platform-script.js build:dir",
    "build:win": "cross-env HLSR_TARGET_PLATFORM=win32 node .electron-vue/build.js && node scripts/build-windows-setup.js",
    "build:win:dir": "cross-env HLSR_TARGET_PLATFORM=win32 node .electron-vue/build.js && node scripts/build-windows-setup.js --dir",
    "dist:win": "npm run build:win",
    "deploy": "node .electron-vue/build.js && electron-builder --publish always",
    "build:linux": "npm run build:linux:dir && node scripts/build-launcher-archive.js && npm run build:bootstrap && npm run audit:package",
    "build:linux:dir": "node .electron-vue/build.js && node scripts/prepare-linux-umu.js && node scripts/prepare-linux-7zip.js && electron-builder --linux --dir --x64 --publish never",
    "build:bootstrap": "node scripts/prepare-installer-assets.js && node scripts/build-bootstrap-app.js && npm run audit:bootstrap",
    "build:clean": "cross-env BUILD_TARGET=clean node .electron-vue/build.js",
    "dev": "node .electron-vue/dev-runner.js",
    "rebuild:native": "node scripts/patch-hlsr-native.js && electron-rebuild -f -w hlsr-native -v 45.3.0 --arch=x64",
    "lint": "eslint -f ./node_modules/eslint-friendly-formatter/index.js src",
    "lint:fix": "eslint -f ./node_modules/eslint-friendly-formatter/index.js --fix src",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production webpack --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production webpack --config .electron-vue/webpack.renderer.config.js",
    "test:linux": "node --test scripts/presence-endpoint-selftest.js scripts/linux-selftest.js scripts/livesplit-overlay-selftest.js scripts/livesplit-splits-selftest.js scripts/proton-update-selftest.js scripts/window-size-selftest.js scripts/hl1-selftest.js scripts/practice-saves-selftest.js scripts/cfg-files-selftest.js scripts/build-transfer-selftest.js",
    "test:delivery": "node scripts/run-delivery-tests.js",
    "test:ghosting": "node --test scripts/ghosting-settings-selftest.js scripts/ghosting-scene-preview-selftest.js scripts/ghosting-assets-selftest.js scripts/ghosting-integration-selftest.js scripts/player-personalization-selftest.js scripts/ghosting-vulkan-selftest.js",
    "test:personalization-codes": "node --test scripts/personalization-code-selftest.js",
    "test:ipc": "node --test scripts/ipc-contract-selftest.js",
    "test:demo": "node --test scripts/demo-tool-headers-selftest.js scripts/demo-tool-planner-selftest.js scripts/demo-tool-jobs-selftest.js scripts/demo-tool-ffmpeg-selftest.js scripts/demo-tool-ghosting-selftest.js scripts/demo-tool-ghrender-selftest.js scripts/demo-tool-hl1-selftest.js scripts/demo-tool-ui-selftest.js",
    "test:ui": "node --test scripts/launcher-ui-selftest.js scripts/pane-size-selftest.js scripts/game-config-selftest.js scripts/hl1-pack-preview-selftest.js scripts/ghost-runs-selftest.js scripts/cancellation-selftest.js scripts/news-selftest.js scripts/sponsors-selftest.js scripts/tray-selftest.js scripts/online-profile-selftest.js scripts/cfg-text-ops-selftest.js scripts/cfg-document-selftest.js scripts/player-config-selftest.js scripts/config-migration-selftest.js scripts/player-binds-selftest.js scripts/cfg-import-flatten-selftest.js scripts/single-config-owner-cfg-selftest.js scripts/single-config-owner-hl1-selftest.js scripts/config-tour-selftest.js scripts/hl1-config-check-selftest.js",
    "test:downloads": "node --test scripts/download-settings-selftest.js scripts/user-configs-selftest.js scripts/delivery-errors-selftest.js scripts/steam-detect-selftest.js scripts/game-pack-selftest.js scripts/delivery-trust-selftest.js scripts/custom-packs-selftest.js",
    "test:diagnostics": "node --test scripts/diagnostics-selftest.js scripts/crash-report-selftest.js",
    "test:attestation": "node --test scripts/attestation-selftest.js",
    "eula:sync": "node scripts/sync-eula.js",
    "audit:package": "node scripts/audit-packaged-content.js",
    "audit:bootstrap": "node scripts/audit-bootstrap-app.js",
    "audit:licenses": "node scripts/audit-licenses.js",
    "verify:packaged-launcher": "node scripts/verify-packaged-launcher.js",
    "smoke:packaged-launcher": "node scripts/qa-packaged-smoke.js",
    "launcher:release:prepare": "node scripts/launcher-release-prepare.js",
    "launcher:release:verify": "node scripts/verify-launcher-release.js",
    "test:launcher-update": "node --test scripts/launcher-update-selftest.js scripts/launcher-chunks-selftest.js",
    "test:windows-install": "node --test scripts/windows-install-selftest.js scripts/seven-zip-selftest.js",
    "launcher:release:prepare:linux": "node scripts/launcher-release-prepare-linux.js",
    "launcher:release:verify:linux": "node scripts/verify-launcher-release-linux.js",
    "launcher:publish:github": "node scripts/publish-launcher-linux.js"
  },
  "build": {
    "productName": "HLSR",
    "afterPack": "./scripts/after-pack-linux.js",
    "executableName": "HLSR",
    "appId": "com.hlsrteam.hlsr",
    "copyright": "Copyright © 2020-2026 HLSR Team",
    "directories": {
      "output": "build",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/electron/**/*",
      "icons",
      "!**/*.map",
      "!**/node_modules/7zip-bin/mac/**",
      "!**/node_modules/7zip-bin/{win,linux}/**",
      "**/node_modules/7zip-bin/${os}/**",
      "!**/node_modules/7zip-bin/win/**",
      "!**/node_modules/hlsr-native/src/**",
      "!**/node_modules/hlsr-native/bin/**",
      "!**/node_modules/hlsr-native/test.js",
      "!**/node_modules/hlsr-native/binding.gyp",
      "!**/node_modules/hlsr-native/build/obj/**",
      "!**/node_modules/hlsr-native/build/Release/obj/**",
      "!**/node_modules/hlsr-native/build/Release/main.{exp,ilk,lib,pdb}",
      "!**/node_modules/hlsr-native/build/{binding.sln,config.gypi,main.vcxproj,main.vcxproj.filters}",
      "!**/node_modules/7zip-bin/7x.sh",
      "!**/node_modules/**/{test,tests,__tests__,spec,example,examples,demo,docs,doc,.github,.idea,.vscode}/**",
      "!**/node_modules/**/*.{md,markdown,ts,jsx,vue,scss,sass,less,snap}",
      "!**/node_modules/**/{.editorconfig,.eslintrc.js,.eslintrc.json,.eslintrc.yml,.babelrc,.npmignore,.travis.yml,appveyor.yml,CHANGELOG,CHANGELOG.md,AUTHORS,CONTRIBUTING.md,FUNDING.yml}",
      "!**/node_modules/vue-material/src/**",
      "!**/node_modules/vue/packages/**",
      "!**/node_modules/vue/src/**",
      "!**/node_modules/vue-toc/src/**",
      "!**/node_modules/vue-codemirror/src/**",
      "**/node_modules/**/LICENSE*",
      "**/node_modules/**/license*",
      "**/node_modules/**/COPYING*",
      "!qa-out{,/**/*}",
      "!build-qa{,/**/*}",
      "!build-qa*{,/**/*}",
      "!test{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/HLSR-LICENSE.txt"
      },
      {
        "from": "build/license-en.txt",
        "to": "licenses/LICENSE_en.txt"
      },
      {
        "from": "build/license-ru.txt",
        "to": "licenses/LICENSE_ru.txt"
      },
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "licenses/THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "build/SOURCE-SDK-LICENSE.txt",
        "to": "licenses/SOURCE-SDK-LICENSE.txt"
      },
      {
        "from": "build/thirdpartylegalnotices.txt",
        "to": "licenses/thirdpartylegalnotices.txt"
      },
      {
        "from": "resources/livesplit-overlay",
        "to": "livesplit-overlay",
        "filter": [
          "proxy-d3d9.dll",
          "proxy-opengl32.dll"
        ]
      },
      {
        "from": "resources/livesplit-components",
        "to": "livesplit-components"
      }
    ],
    "npmRebuild": false,
    "win": {
      "executableName": "HLSR",
      "publish": [
        {
          "provider": "github",
          "owner": "HL-HLSR",
          "repo": "HLSR-Releases",
          "releaseType": "release"
        }
      ],
      "asarUnpack": [
        "**/node_modules/hlsr-native/build/Release/*.node",
        "**/node_modules/hlsr-native/build/Release/steam_api*.dll"
      ],
      "extraResources": [
        {
          "from": "build/installer",
          "to": "installer"
        },
        {
          "from": "resources/7zip/win-x64",
          "to": "7zip"
        },
        {
          "from": "resources/demo-render",
          "to": "demo-render"
        }
      ],
      "icon": "build/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "HLSR-Setup-${version}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "HLSR-Setup-${version}.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": true,
      "unicode": true
    },
    "linux": {
      "executableName": "hlsr",
      "publish": [
        {
          "provider": "generic",
          "url": "https://hlsr.pro/downloads/launcher/linux/stable/"
        }
      ],
      "extraResources": [
        {
          "from": "build/icons/256x256.png",
          "to": "icons/hlsr.png"
        },
        {
          "from": "build/umu/umu-run",
          "to": "umu/umu-run"
        },
        {
          "from": "resources/livesplit-fonts",
          "to": "livesplit-fonts"
        },
        {
          "from": "resources/livesplit-fixes",
          "to": "livesplit-fixes"
        },
        {
          "from": "resources/presence-relay",
          "to": "presence-relay"
        },
        {
          "from": "resources/linux/install-userns-profile.sh",
          "to": "linux/install-userns-profile.sh"
        },
        {
          "from": "resources/livesplit-overlay",
          "to": "livesplit-overlay",
          "filter": [
            "hlsr-overlay64.exe",
            "hlsr-share64.dll"
          ]
        }
      ],
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons/256x256.png",
      "artifactName": "HLSR-Setup-${version}-linux-x86_64.${ext}"
    }
  },
  "dependencies": {
    "7zip-bin": "^5.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bytenode": "2.1.0",
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.11",
    "js-yaml": "5.5.0",
    "node-7z": "^3.0.0"
  },
  "optionalDependencies": {
    "hlsr-native": "1.0.8",
    "register-scheme": "file:scripts/stubs/register-scheme"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@babel/preset-env": "8.0.7",
    "@electron/asar": "^4.3.1",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-debug": "5.0.0",
    "electron-devtools-installer": "4.0.0",
    "eslint": "10.14.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "node-loader": "2.1.0",
    "sass": "1.107.0",
    "sass-loader": "17.1.0",
    "style-loader": "4.0.0",
    "terser": "5.51.2",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-loader": "17.4.2",
    "vue-router": "5.4.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "overrides": {
    "register-scheme": "$register-scheme"
  }
}
