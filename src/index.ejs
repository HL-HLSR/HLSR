<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <% const isDevelopment = !!htmlWebpackPlugin.options.isDevelopment; %>
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'<%= isDevelopment ? " 'unsafe-eval'" : "" %>; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: file:<%= isDevelopment ? " http://127.0.0.1:18895 http://127.0.0.1:18896" : "" %>; font-src 'self' data:; media-src 'self' hlsr-media:; connect-src 'self' https:<%= isDevelopment ? " http://localhost:9080 ws://localhost:9080" : "" %>; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; form-action 'none'"
    >
    <title>HLSR</title>
  </head>
  <body>
    <div id="root" style="display: contents"></div>
  </body>
</html>
