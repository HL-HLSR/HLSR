{
  "id": "demo/player-full",
  "state": "Плеер во весь экран: окно на монитор (demo-player-fullscreen — true), плеер поверх шапки и колонки",
  "base": "demo/_base",
  "steps": [
    {
      "click": {
        "css": ".game-rail .rail-item[aria-label=\"Демо\"]",
        "view": "rail-demo"
      }
    },
    {
      "click": {
        "css": ".dmp__list .dmp__group:nth-child(2) .dmp__item:nth-of-type(1)",
        "view": "dmp-item-gh-run"
      }
    },
    {
      "click": {
        "css": ".dpl__controls > .dpl__btn:last-child",
        "view": "dpl-full"
      }
    },
    {
      "move": [
        800,
        880
      ]
    }
  ],
  "invoke": {
    "demo-player-fullscreen": true
  }
}
