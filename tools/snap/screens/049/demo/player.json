      }
    },
    {
      "click": {
        "css": ".dpl__track",
        "view": "dpl-track"
      }
    },
    {
      "click": {
        "css": ".dpl__mark",
        "view": "dpl-from"
      }
    },
    {
      "hover": {
        "css": ".dpl__track",
        "view": "dpl-track"
      }
    }
  ]
