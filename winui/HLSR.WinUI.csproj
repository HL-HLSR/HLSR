<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HLSR</RootNamespace>
    <AssemblyName>HLSR</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\hlsr.ico</ApplicationIcon>
    <Version>0.5.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Службы HLSR на Rust: cargo build -p hlsr-ffi (release для Release, debug для Debug). -->
    <HlsrRustDir>$(MSBuildThisFileDirectory)..\</HlsrRustDir>
    <HlsrRustProfile Condition="'$(Configuration)' == 'Release'">release</HlsrRustProfile>
    <HlsrRustProfile Condition="'$(Configuration)' != 'Release'">debug</HlsrRustProfile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(HlsrRustDir)target\$(HlsrRustProfile)\hlsr_ffi.dll" Link="hlsr_ffi.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(HlsrRustDir)resources\**\*" Exclude="$(HlsrRustDir)resources\linux\**;$(HlsrRustDir)resources\7zip\linux\**" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="BuildHlsrRust" BeforeTargets="BeforeBuild" Condition="'$(SkipRust)' != 'true'">
    <Exec Command="cargo build -p hlsr-ffi --offline $(HlsrCargoFlags)" WorkingDirectory="$(HlsrRustDir)" />
  </Target>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <HlsrCargoFlags>--release</HlsrCargoFlags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>
</Project>
