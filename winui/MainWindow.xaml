<Window
    x:Class="HLSR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HLSR">

    <Grid x:Name="Root" Background="{ThemeResource W10PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна как у приложений UWP в Windows 10: название слева, мелким шрифтом. -->
        <Grid x:Name="TitleBar" Background="{ThemeResource W10ChromeBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="10">
                <Image Source="ms-appx:///Assets/hlsr.png" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Text="HLSR" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.PaneHeader>
                <TextBlock x:Name="PaneTitle" Text="HLSR" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
            </NavigationView.PaneHeader>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavFolder" SelectsOnInvoked="False" Tapped="OnOpenGamesFolder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Ошибка запуска служб. -->
        <Grid x:Name="StartupFailure" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource W10PageBackground}" Padding="48">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="12">
                <TextBlock Style="{StaticResource W10PageTitleText}" Text="HLSR" />
                <TextBlock x:Name="StartupFailureText" Style="{StaticResource W10BodyText}" IsTextSelectionEnabled="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
