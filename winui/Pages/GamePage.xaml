<Page
    x:Class="HLSR.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource W10PageBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Шапка: арт игры с затуханием в фон страницы, как у страниц Магазина Windows 10. -->
            <Grid Height="360">
                <Image x:Name="Hero" Stretch="UniformToFill" VerticalAlignment="Top" />
                <Rectangle Fill="{ThemeResource W10HeroFade}" />
                <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,8">
                    <TextBlock x:Name="GameTitle" Style="{StaticResource W10HeaderText}" />
                    <TextBlock x:Name="GameSubtitle" Style="{StaticResource W10CaptionText}" FontSize="15" Margin="2,2,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="36,16,36,36" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
                <!-- Действия. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="MainButton" Style="{StaticResource AccentButtonStyle}" MinWidth="200" Height="40" Click="OnMainButton">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="MainGlyph" FontFamily="{StaticResource Win10Icons}" FontSize="16" Glyph="&#xE768;" />
                            <TextBlock x:Name="MainText" FontSize="15" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Height="40" MinWidth="40" Visibility="Collapsed" Click="OnCancel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource Win10Icons}" FontSize="14" Glyph="&#xE711;" />
                            <TextBlock x:Name="CancelText" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Height="40" Width="48" Padding="0">
                        <FontIcon FontFamily="{StaticResource Win10Icons}" FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem x:Name="MenuFolder" Tag="game-menu-open-folder" Click="OnMenu">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuScreenshots" Tag="game-menu-open-screenshots" Click="OnMenu">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShortcut" Tag="game-menu-create-shortcut" Click="OnMenu">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuUpdates" Tag="game-menu-check-updates" Click="OnMenu">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuVerify" Tag="game-menu-verify-files" Click="OnMenu">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuRepair" Tag="game-menu-repair" Click="OnMenu">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuExportBuild" Tag="export" Click="OnTransfer">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuExportSettings" Tag="export-settings" Click="OnTransfer">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuImportBuild" Tag="import" Click="OnTransfer">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuUninstall" Tag="game-menu-uninstall" Click="OnUninstall">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SettingsButton" Height="40" Click="OnGameSettings">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                            <TextBlock x:Name="SettingsText" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="BuildBox" Height="40" MinWidth="160" VerticalAlignment="Bottom" Visibility="Collapsed" SelectionChanged="OnBuildChanged" />
                </StackPanel>

                <!-- Загрузка. -->
                <StackPanel x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock x:Name="ProgressTitle" Style="{StaticResource W10BaseText}" />
                        <TextBlock x:Name="ProgressPercent" HorizontalAlignment="Right" FontSize="15" />
                    </Grid>
                    <ProgressBar x:Name="Progress" Width="560" Maximum="100" />
                    <TextBlock x:Name="ProgressDetails" Style="{StaticResource W10CaptionText}" />
                </StackPanel>

                <!-- Почему недоступно / ошибка: полоса уведомления Windows 10. -->
                <Border x:Name="Notice" Visibility="Collapsed" Background="{ThemeResource W10ListLowBrush}" Padding="16,12" MaxWidth="720" HorizontalAlignment="Left">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="NoticeGlyph" FontFamily="{StaticResource Win10Icons}" Glyph="&#xE946;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="NoticeTitle" Style="{StaticResource W10BaseText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="NoticeText" Style="{StaticResource W10BodyText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Эпизоды Ghosting. -->
                <StackPanel x:Name="EpisodesPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="EpisodesHeader" Style="{StaticResource W10SubtitleText}" />
                    <StackPanel x:Name="EpisodesList" Spacing="2" />
                </StackPanel>

                <!-- Сведения о сборке. -->
                <StackPanel Spacing="10">
                    <TextBlock x:Name="InfoHeader" Style="{StaticResource W10SubtitleText}" />
                    <Grid x:Name="InfoGrid" ColumnSpacing="32" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
