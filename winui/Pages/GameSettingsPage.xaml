<Page
    x:Class="HLSR.Pages.GameSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource W10PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="36,20,36,0">
            <TextBlock x:Name="PageTitle" Style="{StaticResource W10PageTitleText}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Pivot — вкладки Windows 10 с подчёркиванием. -->
        <Pivot x:Name="Tabs" Grid.Row="1" Margin="24,8,0,0" SelectionChanged="OnTabChanged" />

        <!-- Подвал: как панель команд «Параметров». -->
        <Border x:Name="Footer" Grid.Row="2" Background="{ThemeResource W10ChromeBrush}" Padding="36,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120" IsEnabled="False" Click="OnSave" />
                <Button x:Name="ResetButton" MinWidth="120" Click="OnReset" />
                <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource W10CaptionText}" FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
