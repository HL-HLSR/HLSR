<Page
    x:Class="HLSR.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource W10PageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body" Margin="36,24,36,48" Spacing="8">
            <TextBlock x:Name="PageTitle" Style="{StaticResource W10PageTitleText}" Margin="0,0,0,12" />
        </StackPanel>
    </ScrollViewer>
</Page>
