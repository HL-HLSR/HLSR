<Page
    x:Class="HLSR.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource W10PageBackground}">

    <!-- Как страницы «Параметров» Windows 10: заголовок, разделы, контролы с подписью сверху. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,48" MaxWidth="620" HorizontalAlignment="Left" Spacing="8">
            <TextBlock x:Name="PageTitle" Style="{StaticResource W10PageTitleText}" Margin="0,0,0,12" />

            <!-- Основные. -->
            <TextBlock x:Name="GeneralHeader" Style="{StaticResource W10SubtitleText}" Margin="0,8,0,4" />
            <ComboBox x:Name="LanguageBox" MinWidth="296" SelectionChanged="OnLanguageChanged">
                <ComboBoxItem Content="Русский" Tag="ru" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <TextBlock x:Name="LanguageHint" Style="{StaticResource W10CaptionText}" Visibility="Collapsed" />

            <!-- Загрузки. -->
            <TextBlock x:Name="DownloadsHeader" Style="{StaticResource W10SubtitleText}" Margin="0,28,0,4" />
            <TextBlock x:Name="PathLabel" FontSize="15" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="PathBox" Width="380" IsReadOnly="True" />
                <Button x:Name="BrowseButton" Click="OnBrowse" />
            </StackPanel>
            <TextBlock x:Name="PathInfo" Style="{StaticResource W10CaptionText}" />
            <ComboBox x:Name="SpeedBox" MinWidth="296" Margin="0,12,0,0" SelectionChanged="OnSpeedChanged" />

            <!-- Интеграции. -->
            <TextBlock x:Name="IntegrationsHeader" Style="{StaticResource W10SubtitleText}" Margin="0,28,0,4" />
            <ToggleSwitch x:Name="DiscordSwitch" Toggled="OnDiscordToggled" />
            <TextBlock x:Name="DiscordHint" Style="{StaticResource W10CaptionText}" MaxWidth="560" HorizontalAlignment="Left" />

            <!-- Во время игры и диагностика: собираются в коде. -->
            <StackPanel x:Name="ExtraHost" />

            <!-- О программе. -->
            <TextBlock x:Name="AboutHeader" Style="{StaticResource W10SubtitleText}" Margin="0,28,0,4" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="ms-appx:///Assets/hlsr.png" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HLSR" Style="{StaticResource W10BaseText}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource W10CaptionText}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="UpdaterText" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ProgressBar x:Name="UpdaterProgress" Width="296" HorizontalAlignment="Left" Visibility="Collapsed" Maximum="100" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpdaterButton" Click="OnUpdater" />
                <Button x:Name="LogsButton" Click="OnLogs" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <HyperlinkButton x:Name="SiteLink" NavigateUri="https://hlsr.pro" Padding="0" />
                <HyperlinkButton x:Name="GitHubLink" NavigateUri="https://github.com/HL-HLSR/HLSR" Padding="0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
