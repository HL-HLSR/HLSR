<!--
    Внешний вид Windows 10 (UWP, Fluent 2017–2020) поверх WinUI 3:
    квадратные углы, Segoe UI и Segoe MDL2 Assets, рамки контролов 2 px,
    кнопки «серая плашка + рамка при наведении», акриловая панель навигации
    с полоской акцента, заголовки Segoe UI Light.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Углы: в Windows 10 скруглений нет. -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
    <x:Double x:Key="NavigationViewSelectionIndicatorWidth">5</x:Double>
    <x:Double x:Key="NavigationViewSelectionIndicatorHeight">24</x:Double>
    <x:Double x:Key="NavigationViewSelectionIndicatorRadius">0</x:Double>
    <Thickness x:Key="NavigationViewItemMargin">0</Thickness>
    <Thickness x:Key="NavigationViewItemButtonMargin">0</Thickness>

    <!-- Шрифты Windows 10. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Win10Icons">Segoe MDL2 Assets</FontFamily>

    <!-- Рамки 2 px, как у контролов Windows 10. -->
    <Thickness x:Key="ButtonBorderThemeThickness">2</Thickness>
    <Thickness x:Key="TextControlBorderThemeThickness">2</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    <Thickness x:Key="ComboBoxBorderThemeThickness">2</Thickness>
    <x:Double x:Key="ProgressBarMinHeight">4</x:Double>
    <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
    <Thickness x:Key="ButtonPadding">11,4,11,6</Thickness>

    <!-- Иконки Windows 10: шрифт Segoe MDL2 Assets у всех FontIcon и SymbolIcon. -->
    <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    </Style>

    <!-- Типографика Windows 10 (Header/Subheader — Segoe UI Light). -->
    <Style x:Key="W10HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="W10SubheaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="34" />
    </Style>
    <Style x:Key="W10PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="W10SubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="W10BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="W10BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="W10CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource W10BaseMediumBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="W10PageBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="W10ChromeBrush" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="W10BaseLowBrush" Color="#33000000" />
            <SolidColorBrush x:Key="W10ListLowBrush" Color="#19000000" />
            <SolidColorBrush x:Key="W10BaseMediumBrush" Color="#99000000" />
            <SolidColorBrush x:Key="W10BaseHighBrush" Color="#FF000000" />
            <AcrylicBrush x:Key="W10PaneAcrylic" TintColor="#FFE6E6E6" TintOpacity="0.6" FallbackColor="#FFE6E6E6" />
            <LinearGradientBrush x:Key="W10HeroFade" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFFFFF" />
                <GradientStop Offset="0.6" Color="#33FFFFFF" />
                <GradientStop Offset="1" Color="#FFFFFFFF" />
            </LinearGradientBrush>

            <!-- Кнопка: плашка BaseLow, наведение — рамка BaseMediumLow, нажатие — фон BaseMediumLow. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#33000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66000000" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#33000000" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF000000" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF000000" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66000000" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33000000" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66000000" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#66000000" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

            <!-- Поле ввода и список: рамка 2 px BaseMediumLow, в фокусе — акцент. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#66000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#99000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#66000000" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="{ThemeResource SystemAccentColor}" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#33000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#66000000" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#99000000" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#99000000" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFCCCCCC" />

            <!-- Навигация: акриловая панель, у выбранного пункта — только полоска акцента. -->
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="W10PaneAcrylic" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="W10PaneAcrylic" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#19000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#33000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#19000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#33000000" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver" Color="#19000000" />
            <SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed" Color="#33000000" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FFCCCCCC" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#19000000" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#33000000" />

            <!-- Переключатель Windows 10: включён — заливка акцентом и белый кружок. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#99000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#CC000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CC000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="W10PageBackground" Color="#FF000000" />
            <SolidColorBrush x:Key="W10ChromeBrush" Color="#FF171717" />
            <SolidColorBrush x:Key="W10BaseLowBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="W10ListLowBrush" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="W10BaseMediumBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="W10BaseHighBrush" Color="#FFFFFFFF" />
            <AcrylicBrush x:Key="W10PaneAcrylic" TintColor="#FF1F1F1F" TintOpacity="0.6" FallbackColor="#FF1F1F1F" />
            <LinearGradientBrush x:Key="W10HeroFade" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.6" Color="#40000000" />
                <GradientStop Offset="1" Color="#FF000000" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ButtonBackground" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#66000000" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#80000000" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF000000" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="{ThemeResource SystemAccentColor}" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#66000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#80000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#66000000" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF767676" />

            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="W10PaneAcrylic" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="W10PaneAcrylic" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF000000" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed" Color="#33FFFFFF" />

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FF767676" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#33FFFFFF" />

            <!-- Переключатель Windows 10: включён — заливка акцентом и белый кружок. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CCFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
